# Local Ollama. No API key required for localhost.
AI_ENDPOINT=http://localhost:11434/v1
AI_MODEL=gemma4:latest
DEBUG_COLORS=false

# DeepSeek API. Select a deepseek-* model in the UI or with --model.
DEEPSEEK_TOKEN=

# Local readdocs MCP server with an installed .venv (stdio).
READDOCS_MCP_SERVER=G:/programming/py/git/readthedocs-mcp-server
# Optional: reuse a specific SQLite index. Otherwise the server default is used.
# READTHEDOCS_MCP_DB=G:/programming/py/git/readthedocs-mcp-server/data/readdocs.sqlite3
